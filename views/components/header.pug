- const pages = [{url: '/', title: 'Home'}, {url: '/my-posts', title: 'My Posts'}, {url: '/login', title: 'Login'}, {url: '/register', title: 'Register'}, {url: '/logout', title: 'Log out'}]

header
    .navbar.navbar-expand-lg.navbar-dark.bg-dark
        .container-fluid.container-lg
            a.navbar-brand(href='/') Micro Blogs App
            button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNav' aria-controls='navbarNav' aria-expanded='false' aria-label='Toggle navigation')
                span.navbar-toggler-icon
            #navbarNav.collapse.navbar-collapse
                ul.navbar-nav.ms-auto
                     each page in pages
                         - let isActive = (locals.url === page.url)
                         li.nav-item(class=isActive ? 'active' : '')
                             a.nav-link(href=page.url class=isActive ? 'disabled' : '')=page.title