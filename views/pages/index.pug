extends ../layout

include ../mixins/post

block content
    div.slogan.py-4.bg-secondary.shadow.text-white.text-center
        .container-fluid.container-lg
            h2 Welcome to My App
            p This is the best place to share your posts.

    .container-fluid.container-lg
        section.my-4.px-0
            ul.list-group.d-flex.flex-column.row-gap-3
                if postsList
                    each post in postsList
                        +postComponent(post.author.username, post.title, post.content, post.createdAt)
