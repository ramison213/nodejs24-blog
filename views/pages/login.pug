extends ../layout

block content
    .container-fluid.container-lg.pt-5
        .row.justify-content-center
            .col-12.col-sm-8.col-md-6.col-lg-4
                .card.p-4
                    h1.mb-4.text-center Sign In
                    form(action="/login" method="POST")
                        .mb-3
                            label.form-label(for="username") Username
                            input.form-control(
                                type="text"
                                id="username"
                                name="username"
                                value=(data && data.auth)
                                required
                                class=(errors && errors.auth ? 'is-invalid' : '')
                            )
                            if errors && errors.auth
                                .invalid-feedback= errors.auth
                        .mb-4
                            label.form-label(for="password") Password
                            input.form-control(
                                type="password"
                                id="password"
                                name="password"
                                required
                                class=(errors ? 'is-invalid' : '')
                            )
                            if errors && errors.password
                                .invalid-feedback= errors.password[0]
                            if errors && errors.auth
                                .invalid-feedback= errors.auth
                        button.btn.btn-primary.w-100.mb-2(type="submit") Sign In
                    p.text-center If you don't have an account yet,&nbsp;
                        a(href="/signup") Sign up