mixin postComponent(post)
    li.card
        .card-header.d-flex
            .d-flex.flex-column.row-gap-1
                .author #{ post.author.username }
                .date #{ post.createdAt }

            if (isLoggedIn && currentUrl === '/my-posts')
                form.ms-auto(action=`/posts/${post._id}?_method=DELETE` method="POST")
                    button.btn-close(type="submit" aria-label="Close")
        .card-body.py-1
            h5.card-title.mb-1 #{ post.title }
            p.card-text #{ post.content }

        if isLoggedIn
            .card-footer.text-body-secondary
                .d-flex.justify-content-end
                    form.d-flex(action=`/comments/${post._id}` method="POST")
                        input.form-control.ms-auto(
                            type="text"
                            id="commentField"
                            name="commentContent"
                            required
                        )

                        button.btn.btn-primary.ms-2(type="submit") Comment

                if post.comments.length
                    h6.card-subtitle.mt-1 Comments

                    ul
                        each comment in post.comments
                            li.card.mt-1
                                .card-header #{ comment.author.username }
                                .card-body.p-1.ps-4 #{ comment.content }