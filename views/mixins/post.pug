mixin postComponent(post)
    li.card
        .card-header.d-flex.flex-column
            .author.mb-2= post.author.username
            .date= post.createdAt

            .d-flex.justify-content-end
                if (isLoggedIn && currentUrl === '/my-posts')
                    form.ms-2(action=`/posts/${post._id}?_method=DELETE` method="POST")
                        button.btn.btn-secondary.btn-sm(type="submit") Delete
        .card-body
            h5.card-title= post.title
            p.card-text= post.content
        .card-footer.text-body-secondary
            if isLoggedIn
                .d-flex.justify-content-end
                    form.d-flex(action=`/comments/${post._id}` method="POST")
                        input.form-control.ms-auto(
                            type="text"
                            id="commentField"
                            name="commentContent"
                            required
                        )
                        button.btn.btn-primary.btn-sm.ms-2(type="submit") Comment

            if post.comments.length
                h6.card-subtitle.mt-1= 'Comments'
                ul
                    each comment in post.comments
                        li.card.mt-1
                            .card-header #{comment.author.username}
                            .card-body.p-1.ps-4 #{comment.content}